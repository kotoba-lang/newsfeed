 ;; ── channels ────────────────────────────────────────────────────────────
 ;;
 ;; A channel is a lens over the same article pool, not a private set of feeds.
 ;; :sources may overlap (The Register feeds both) — the keyword and url-hint
 ;; gates decide what belongs to whom.
 ;;
 ;; :min-score exists because one shared all-sections feed will otherwise put
 ;; an article about Windows activation errors into a storage channel. Measured
 ;; on the first real ingest; see the ADR.
 :channels
 [{:channel/id :murakumo-gpu-ai
   :channel/site "murakumo.cloud"
   :channel/title "murakumo GPU/AI news"
   :channel/description "GPU と AI 推論・学習まわりの最新ニュースを、図解モーショングラフィックスで。"
   :channel/lang [:en :ja]
   :channel/sources ["nvidia-developer" "nvidia-newsroom" "arxiv-cs-ar" "arxiv-cs-lg"
                     "phoronix" "semianalysis" "huggingface-blog" "tomshardware"
                     "vllm-releases" "llamacpp-releases" "theregister"
                     ;; Listed on this channel too, on measured evidence rather
                     ;; than by beat: its KV-cache and GPU-adjacent reporting
                     ;; (ScaleFlux, VAST/AMD) scored into the GPU/AI top six on
                     ;; 2026-08-03. The keyword gate keeps the pure-storage
                     ;; items out.
                     "storagereview"]
   :channel/min-score 4
   :channel/window-days 7
   ;; Editorial spread, not relevance. Measured 2026-08-03: ranking alone put
   ;; four arXiv preprints in the top six — correctly scored (an abstract is
   ;; keyword-dense by construction) and wrong for a news bulletin. A preprint
   ;; is a citation; at most one may lead.
   :channel/max-per-source 2
   :channel/max-per-class {"preprint" 1 "release" 2 "trade" 2 :default 2}
   :channel/source-bias {"arxiv-cs-ar" -3 "arxiv-cs-lg" -3}
   :channel/keywords
   {3 ["gpu" "cuda" "hbm" "tensor core" "nvlink" "blackwell" "hopper" "rocm" "tpu"
       "inference" "llm" "quantization" "kv cache" "flash attention" "vllm"
       "moe" "mixture of experts" "tflops" "petaflop" "attention" "transformer"
       "fine-tuning" "pretraining" "accelerator" "interconnect"]
    2 ["ai" "model" "pytorch" "triton" "kernel" "throughput" "latency" "fp8" "int4"
       "int8" "sparsity" "compiler" "benchmark" "training" "serving" "batch"
       "context length" "datacenter" "cluster" "scaling"]
    1 ["nvidia" "amd" "intel" "chip" "silicon" "memory bandwidth" "wafer" "hpc"
       "supercomputer" "open weights"]}
   :channel/url-hints {"/ai/" 3 "/hpc/" 2 "developer.nvidia.com" 3 "arxiv.org" 2
                       "/offbeat/" -6 "/legal/" -3 "/bootnotes/" -6}}

