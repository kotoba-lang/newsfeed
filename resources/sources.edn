   :channel/site "kotobase.net"
   :channel/title "kotobase storage news"
   :channel/description "ストレージ・ファイルシステム・オブジェクトストレージの最新ニュースを、図解モーショングラフィックスで。"
   :channel/lang [:en :ja]
   :channel/sources ["blocksandfiles" "storagereview" "theregister"
                     "openzfs-releases" "minio-releases" "seaweedfs-releases"
                     "iceberg-releases" "phoronix"]
   :channel/min-score 4
   :channel/window-days 7
   ;; Measured 2026-08-03: five of the top six came from one trade outlet. The
   ;; storage trade press is small, so the class cap is looser here than on the
   ;; GPU channel — but no single outlet may supply more than two.
   :channel/max-per-source 2
   :channel/max-per-class {"trade" 4 "release" 2 :default 2}
   :channel/keywords
   {3 ["storage" "ssd" "nvme" "nand" "hdd" "object storage" "block storage"
       "filesystem" "file system" "zfs" "ceph" "erasure coding" "raid"
       "qlc" "tlc" "hamr" "tape" "lakehouse" "iceberg" "parquet"
       "deduplication" "snapshot" "s3" "petabyte" "exabyte"]
    2 ["capacity" "iops" "durability" "replication" "tiering" "backup" "archive"
       "data lake" "cxl" "dram" "memory pool" "flash" "controller" "array"
       "throughput" "latency"]
    1 ["cloud" "disk" "cache" "volume" "bucket" "migration"]}
   :channel/url-hints {"/storage/" 4 "blocksandfiles.com" 3 "storagereview.com" 3
                       "/offbeat/" -6 "/bootnotes/" -6 "/security/" -1}}]}
