 ;; ── channels ────────────────────────────────────────────────────────────
 ;;
 ;; A channel is a lens over the same article pool, not a private set of feeds.
 ;; :sources may overlap (The Register feeds both) — the keyword and url-hint
 ;; gates decide what belongs to whom.
 ;;
 ;; :min-score exists because one shared all-sections feed will otherwise put
 ;; an article about Windows activation errors into a storage channel. Measured
 ;; on the first real ingest; see the ADR.
 :channels
 [{:channel/id :murakumo-gpu-ai
   :channel/site "murakumo.cloud"
   :channel/title "murakumo GPU/AI news"
   :channel/description "GPU と AI 推論・学習まわりの最新ニュースを、図解モーショングラフィックスで。"
   :channel/lang [:en :ja]
   :channel/sources ["nvidia-developer" "nvidia-newsroom" "arxiv-cs-ar" "arxiv-cs-lg"
                     "phoronix" "semianalysis" "huggingface-blog" "tomshardware"
                     "vllm-releases" "llamacpp-releases" "theregister"
                     ;; Listed on this channel too, on measured evidence rather
                     ;; than by beat: its KV-cache and GPU-adjacent reporting
                     ;; (ScaleFlux, VAST/AMD) scored into the GPU/AI top six on
                     ;; 2026-08-03. The keyword gate keeps the pure-storage
                     ;; items out.
                     "storagereview"]
   :channel/min-score 4
   :channel/window-days 7
   ;; Editorial spread, not relevance. Measured 2026-08-03: ranking alone put
   ;; four arXiv preprints in the top six — correctly scored (an abstract is
   ;; keyword-dense by construction) and wrong for a news bulletin. A preprint
   ;; is a citation; at most one may lead.
   :channel/max-per-source 2
   :channel/max-per-class {"preprint" 1 "release" 2 "trade" 2 :default 2}
   :channel/source-bias {"arxiv-cs-ar" -3 "arxiv-cs-lg" -3}
   :channel/keywords
   {3 ["gpu" "cuda" "hbm" "tensor core" "nvlink" "blackwell" "hopper" "rocm" "tpu"
       "inference" "llm" "quantization" "kv cache" "flash attention" "vllm"
       "moe" "mixture of experts" "tflops" "petaflop" "attention" "transformer"
       "fine-tuning" "pretraining" "accelerator" "interconnect"]
    2 ["ai" "model" "pytorch" "triton" "kernel" "throughput" "latency" "fp8" "int4"
       "int8" "sparsity" "compiler" "benchmark" "training" "serving" "batch"
       "context length" "datacenter" "cluster" "scaling"]
    1 ["nvidia" "amd" "intel" "chip" "silicon" "memory bandwidth" "wafer" "hpc"
       "supercomputer" "open weights"]}
   :channel/url-hints {"/ai/" 3 "/hpc/" 2 "developer.nvidia.com" 3 "arxiv.org" 2
                       "/offbeat/" -6 "/legal/" -3 "/bootnotes/" -6}}

  {:channel/id :kotobase-storage
   :channel/site "kotobase.net"
   :channel/title "kotobase storage news"
   :channel/description "ストレージ・ファイルシステム・オブジェクトストレージの最新ニュースを、図解モーショングラフィックスで。"
   :channel/lang [:en :ja]
   :channel/sources ["blocksandfiles" "storagereview" "theregister"
                     "openzfs-releases" "minio-releases" "seaweedfs-releases"
                     "iceberg-releases" "phoronix"]
   :channel/min-score 4
   :channel/window-days 7
   ;; Measured 2026-08-03: five of the top six came from one trade outlet. The
   ;; storage trade press is small, so the class cap is looser here than on the
   ;; GPU channel — but no single outlet may supply more than two.
   :channel/max-per-source 2
   :channel/max-per-class {"trade" 4 "release" 2 :default 2}
   :channel/keywords
   {3 ["storage" "ssd" "nvme" "nand" "hdd" "object storage" "block storage"
       "filesystem" "file system" "zfs" "ceph" "erasure coding" "raid"
       "qlc" "tlc" "hamr" "tape" "lakehouse" "iceberg" "parquet"
       "deduplication" "snapshot" "s3" "petabyte" "exabyte"]
    2 ["capacity" "iops" "durability" "replication" "tiering" "backup" "archive"
       "data lake" "cxl" "dram" "memory pool" "flash" "controller" "array"
       "throughput" "latency"]
    1 ["cloud" "disk" "cache" "volume" "bucket" "migration"]}
   :channel/url-hints {"/storage/" 4 "blocksandfiles.com" 3 "storagereview.com" 3
                       "/offbeat/" -6 "/bootnotes/" -6 "/security/" -1}}

  {:channel/id :itonami-supply-chain
   :channel/site "itonami.cloud"
   :channel/title "itonami 海運・物流ニュース"
   :channel/description "海運・港湾・サプライチェーンの最新ニュースを、図解モーショングラフィックスで。"
   :channel/lang [:en :ja]
   :channel/sources ["one-line" "meti" "gcaptain" "splash247" "maritime-executive"
                     "container-news" "offshore-energy" "joc" "freightwaves"
                     "supplychaindive"]
   :channel/min-score 4
   :channel/window-days 7
   ;; maritime-executive は 1 outlet で 56 item 出る (roster 最大)。トレード press の
   ;; 層が GPU/storage より厚いので class 上限は緩めだが、source 上限は同じ 2。
   :channel/max-per-source 2
   :channel/max-per-class {"trade" 4 "press" 2 "official" 2 :default 2}
   ;; FreightWaves は実測でトラック輸送・犯罪ニュースの比率が高く、海運の
   ;; running order に入れると本題を押し出す。keyword gate で拾えるものだけ通す。
   :channel/source-bias {"freightwaves" -2}
   :channel/keywords
   {3 ["shipping" "container" "vessel" "tanker" "bulk carrier" "lng carrier"
       "port" "terminal" "freight rate" "charter" "shipyard" "newbuilding"
       "海運" "商船三井" "日本郵船" "川崎汽船" "港湾" "コンテナ" "造船"
       ;; 社名は曖昧でない表記だけ。"MOL" 単体は MOL Nyrt.(ハンガリーの石油会社)
       ;; と衝突するので入れない。
       "mitsui o.s.k." "nippon yusen" "kawasaki kisen" "ocean network express"
       "supply chain" "サプライチェーン" "物流"]
    2 ["logistics" "cargo" "teu" "dwt" "imo" "decarbonisation" "decarbonization"
       "ammonia" "methanol" "bunker" "emission" "route" "canal" "congestion"
       "carrier" "shipowner" "fleet" "貿易" "輸出" "輸入" "脱炭素"]
    1 ["trade" "tariff" "warehouse" "rail" "trucking" "procurement" "inventory"
       "経済産業省" "国土交通省"]}
   ;; MOL / NYK / K-Line は feed を持たないので発行者として購読できない。出来事と
   ;; してトレード press に載ることはある (実測 2026-08-03 の 1,569 article では
   ;; NYK の NS United 買収 1 件のみ、商船三井は 0 件) ので、3 点タイアに社名を
   ;; 置いて拾えたときは確実に押し上げる。**`MOL` を keyword にはしない** —
   ;; ハンガリーの石油会社 MOL Nyrt. と衝突し、実際にその記事を商船三井と
   ;; 誤認しかけた (:sources の該当コメント参照)。
   :channel/url-hints {"/shipping/" 3 "/ports/" 3 "/logistics/" 2
                       "gcaptain.com" 2 "splash247.com" 2 "maritime-executive.com" 2
                       "meti.go.jp" 2
                       "/trucking/" -3 "/crime/" -4 "/opinion/" -2}}]}
